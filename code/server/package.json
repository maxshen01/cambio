{
  "name": "cambio-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "test": "node --test --test-reporter ./test/helpers/reporter.js \"test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "test:lobby": "node --test --test-reporter ./test/helpers/reporter.js \"test/lobby/**/*.test.js\"",
    "test:setup": "node --test --test-reporter ./test/helpers/reporter.js \"test/setup/**/*.test.js\"",
    "test:turns": "node --test --test-reporter ./test/helpers/reporter.js \"test/turns/**/*.test.js\"",
    "test:cards": "node --test --test-reporter ./test/helpers/reporter.js \"test/cards/**/*.test.js\"",
    "test:recovery": "node --test --test-reporter ./test/helpers/reporter.js \"test/recovery/**/*.test.js\"",
    "test:fast": "node --test --test-reporter ./test/helpers/reporter.js \"test/**/*.unit.test.js\"",
    "test:integration": "node --test --test-reporter ./test/helpers/reporter.js \"test/**/*.integration.test.js\"",
    "test:assets": "node --test --test-reporter ./test/helpers/reporter.js \"test/**/*.asset.test.js\""
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  }
}
